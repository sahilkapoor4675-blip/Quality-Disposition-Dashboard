# Render Environment Variables (do NOT commit real secrets)
# Use the Supabase Shared Pooler / Session mode connection string for Render Free.
DATABASE_URL=postgresql://postgres.<project-ref>:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_LIMIT_MB=500
