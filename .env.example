# Render Environment Variables (do NOT commit real secrets)
# Use the Supabase Shared Pooler / Session mode connection string for Render Free.
DATABASE_URL=postgresql://postgres.<project-ref>:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_LIMIT_MB=500

# Backup-failure alerts (all optional; with none set, failures are only logged/shown in /admin).
# Webhook works with Slack, Teams, Discord or any endpoint that accepts JSON POST.
ALERT_WEBHOOK_URL=
# Email alerts need BOTH recipients and an SMTP server. Many free hosts block outbound SMTP,
# so prefer the webhook there.
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Re-alert interval while a failure persists (default 360 = 6 h). A "recovered" message is sent once when it clears.
ALERT_COOLDOWN_MINUTES=360
